diff --git a/src/gbi/rt64_gbi_f3dex2.cpp b/src/gbi/rt64_gbi_f3dex2.cpp
index 9f3a12c..8cb120c 100644
--- a/src/gbi/rt64_gbi_f3dex2.cpp
+++ b/src/gbi/rt64_gbi_f3dex2.cpp
@@ -157,6 +157,39 @@ namespace RT64 {
             // TODO
         }
 
+        // F3DEX2 does not read ahead on G_TEXRECT/G_TEXRECTFLIP: like every other command it
+        // consumes 8 bytes and only stores its words in DMEM. G_RDPHALF_1 stores the S/T word, and
+        // G_RDPHALF_2 sends the stored rectangle to the RDP with its own word as DsDx/DtDy. Games
+        // that write the 16-byte RDP form of a texture rectangle into an F3DEX2 display list (e.g.
+        // WinBack's cloud layer, which uses it only to load TMEM) depend on the commands that follow
+        // it still being executed, and on no rectangle being drawn.
+        void texrect(State *state, DisplayList **dl) {
+            state->microcode.texrectW0 = (*dl)->w0;
+            state->microcode.texrectW1 = (*dl)->w1;
+        }
+
+        void rdpHalf2(State *state, DisplayList **dl) {
+            state->microcode.half2 = (*dl)->w1;
+
+            const uint32_t w0 = state->microcode.texrectW0;
+            const uint32_t w1 = state->microcode.texrectW1;
+            const uint8_t command = w0 >> 24;
+            if ((command != G_TEXRECT) && (command != G_TEXRECTFLIP)) {
+                return;
+            }
+
+            const int32_t lrx = (w0 >> 12) & 0xFFF;
+            const int32_t lry = w0 & 0xFFF;
+            const uint8_t tile = (w1 >> 24) & 0x7;
+            const int32_t ulx = (w1 >> 12) & 0xFFF;
+            const int32_t uly = w1 & 0xFFF;
+            const int16_t uls = int16_t(state->microcode.half1 >> 16);
+            const int16_t ult = int16_t(state->microcode.half1 & 0xFFFF);
+            const int16_t dsdx = int16_t((*dl)->w1 >> 16);
+            const int16_t dtdy = int16_t((*dl)->w1 & 0xFFFF);
+            state->rdp->drawTexRect(ulx, uly, lrx, lry, tile, uls, ult, dsdx, dtdy, command == G_TEXRECTFLIP);
+        }
+
         void setup(GBI *gbi) {
             gbi->constants = {
                 { F3DENUM::G_MTX_MODELVIEW, 0x00 },
@@ -173,7 +206,9 @@ namespace RT64 {
             };
 
             gbi->map[F3DEX2_G_RDPHALF_1] = &GBI_F3D::rdpHalf1;
-            gbi->map[F3DEX2_G_RDPHALF_2] = &GBI_F3D::rdpHalf2;
+            gbi->map[F3DEX2_G_RDPHALF_2] = &rdpHalf2;
+            gbi->map[G_TEXRECT] = &texrect;
+            gbi->map[G_TEXRECTFLIP] = &texrect;
             gbi->map[F3DEX2_G_SETOTHERMODE_H] = &setOtherModeH;
             gbi->map[F3DEX2_G_SETOTHERMODE_L] = &setOtherModeL;
             gbi->map[F3DEX2_G_SPNOOP] = &GBI_EXTENDED::noOpHook;
diff --git a/src/hle/rt64_microcode.h b/src/hle/rt64_microcode.h
index ca79462..ff72837 100644
--- a/src/hle/rt64_microcode.h
+++ b/src/hle/rt64_microcode.h
@@ -10,5 +10,9 @@ namespace RT64 {
     struct Microcode {
         uint32_t half1;
         uint32_t half2;
+
+        // F3DEX2's G_TEXRECT/G_TEXRECTFLIP words, held until G_RDPHALF_2 sends the rectangle.
+        uint32_t texrectW0 = 0;
+        uint32_t texrectW1 = 0;
     };
 };
