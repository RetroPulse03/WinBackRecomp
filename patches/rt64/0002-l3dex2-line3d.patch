+    // Draws a line the way L3DEX2 does. The microcode clips the line and sends the RDP a single
+    // edge-walked primitive (width is in quarter pixels and is offset by 3):
+    // - At least as tall as it is wide: a parallelogram with horizontal top and bottom edges, reaching
+    //   width + 3 quarter pixels to each side of the line horizontally.
+    // - Wider than it is tall: a parallelogram reaching width + 3 quarter pixels above and below the
+    //   line, with its ends cut vertically by a scissor set to the line's X extent. A line that is
+    //   flat or almost flat is drawn as a rectangle at the height of its top endpoint.
+    // Lines ignore the culling flags. With flat shading, the color comes from colorVtx and the alpha
+    // from each endpoint. The quad is built from copies of the endpoints with screen XY overridden.
+    void RSP::drawLine(uint8_t a, uint8_t b, uint8_t colorVtx, int8_t width) {
+        if ((a >= RSP_MAX_VERTICES) || (b >= RSP_MAX_VERTICES) || (colorVtx >= RSP_MAX_VERTICES)) {
+            assert(false && "Vertex index is not valid. DL is possibly corrupted.");
+            return;
+        }
+
+        const int workloadCursor = state->ext.workloadQueue->writeCursor;
+        Workload &workload = state->ext.workloadQueue->workloads[workloadCursor];
+        auto &drawData = workload.drawData;
+        uint32_t &geometryMode = geometryModeStack[geometryModeStackSize - 1];
+        const uint32_t srcIndices[2] = { indices[a], indices[b] };
+        const uint32_t colorIndex = indices[colorVtx];
+        used[a] = used[b] = used[colorVtx] = true;
+
+        // Clip the line in clip space against the near plane and against a guard band, which keeps
+        // the endpoints within range of the screen coordinates. Only offscreen parts are removed.
+        const hlslpp::float4 clip0 = drawData.posTransformed[srcIndices[0]];
+        const hlslpp::float4 clip1 = drawData.posTransformed[srcIndices[1]];
+        const float GuardBand = 4.0f;
+        const float MinW = 1e-5f;
+        float t0 = 0.0f, t1 = 1.0f;
+        auto clipPlane = [&](float d0, float d1) {
+            if ((d0 < 0.0f) && (d1 < 0.0f)) {
+                t0 = 1.0f;
+                t1 = 0.0f;
+            }
+            else if (d0 < 0.0f) {
+                t0 = std::max(t0, d0 / (d0 - d1));
+            }
+            else if (d1 < 0.0f) {
+                t1 = std::min(t1, d0 / (d0 - d1));
+            }
+        };
+
+        clipPlane(clip0.z + clip0.w, clip1.z + clip1.w);
+        clipPlane(clip0.w - MinW, clip1.w - MinW);
+        clipPlane(GuardBand * clip0.w - clip0.x, GuardBand * clip1.w - clip1.x);
+        clipPlane(GuardBand * clip0.w + clip0.x, GuardBand * clip1.w + clip1.x);
+        clipPlane(GuardBand * clip0.w - clip0.y, GuardBand * clip1.w - clip1.y);
+        clipPlane(GuardBand * clip0.w + clip0.y, GuardBand * clip1.w + clip1.y);
+        if (t0 >= t1) {
+            return;
+        }
+
+        // Each endpoint is the original vertex, or a new vertex interpolated along the line. Clip space
+        // is linear in model space, so the model position is interpolated with the same factor.
+        const interop::RSPViewport &viewport = viewportStack[viewportStackSize - 1];
+        const bool usesLighting = geometryMode & G_LIGHTING;
+        uint32_t endIndices[2];
+        const float endT[2] = { t0, t1 };
+        for (int e = 0; e < 2; e++) {
+            const float t = endT[e];
+            if (t == float(e)) {
+                endIndices[e] = srcIndices[e];
+                continue;
+            }
+
+            const uint32_t i0 = srcIndices[0], i1 = srcIndices[1];
+            const uint32_t n = copyVertex(srcIndices[e]);
+            for (int i = 0; i < 3; i++) {
+                const float p0 = drawData.posShorts[i0 * 3 + i], p1 = drawData.posShorts[i1 * 3 + i];
+                drawData.posShorts[n * 3 + i] = int16_t(std::lround(p0 + (p1 - p0) * t));
+            }
+
+            for (int i = 0; i < 4; i++) {
+                const bool isSigned = usesLighting && (i < 3);
+                const float c0 = isSigned ? float(int8_t(drawData.normColBytes[i0 * 4 + i])) : float(drawData.normColBytes[i0 * 4 + i]);
+                const float c1 = isSigned ? float(int8_t(drawData.normColBytes[i1 * 4 + i])) : float(drawData.normColBytes[i1 * 4 + i]);
+                drawData.normColBytes[n * 4 + i] = uint8_t(std::lround(c0 + (c1 - c0) * t));
+            }
+
+            for (int i = 0; i < 2; i++) {
+                const float c0 = drawData.tcFloats[i0 * 2 + i], c1 = drawData.tcFloats[i1 * 2 + i];
+                drawData.tcFloats[n * 2 + i] = c0 + (c1 - c0) * t;
+            }
+
+            const hlslpp::float4 clipPos = clip0 + (clip1 - clip0) * t;
+            const hlslpp::float3 screenPos = (clipPos.xyz / hlslpp::float3(clipPos.w, -clipPos.w, clipPos.w)) * viewport.scale + viewport.translate;
+            drawData.posTransformed[n] = clipPos;
+            drawData.posScreen[n] = screenPos;
+            endIndices[e] = n;
+        }
+
+        // The microcode works on screen coordinates in quarter pixels, with the top endpoint first.
+        int32_t qx[2], qy[2];
+        for (int e = 0; e < 2; e++) {
+            const hlslpp::float3 &screenPos = drawData.posScreen[endIndices[e]];
+            qx[e] = int32_t(std::lround(screenPos[0] * 4.0f));
+            qy[e] = int32_t(std::lround(screenPos[1] * 4.0f));
+        }
+
+        const int top = (qy[1] < qy[0]) ? 1 : 0;
+        const int bottom = 1 - top;
+        const int32_t dx = qx[bottom] - qx[top];
+        const int32_t dy = qy[bottom] - qy[top];
+        const int32_t offset = int32_t(width) + 3;
+        int32_t cornerX[4], cornerY[4];
+        if (std::abs(dx) <= dy) {
+            cornerX[0] = qx[top] - offset;    cornerY[0] = qy[top];
+            cornerX[1] = qx[top] + offset;    cornerY[1] = qy[top];
+            cornerX[2] = qx[bottom] + offset; cornerY[2] = qy[bottom];
+            cornerX[3] = qx[bottom] - offset; cornerY[3] = qy[bottom];
+        }
+        else {
+            const int32_t MaxFlatSlope = 0x755;
+            const bool flat = (dy == 0) || (std::abs(int32_t(std::floor(double(dx) / double(dy)))) > MaxFlatSlope);
+            const int32_t bottomY = flat ? qy[top] : qy[bottom];
+            cornerX[0] = qx[top];    cornerY[0] = qy[top] - offset;
+            cornerX[1] = qx[top];    cornerY[1] = qy[top] + offset;
+            cornerX[2] = qx[bottom]; cornerY[2] = bottomY + offset;
+            cornerX[3] = qx[bottom]; cornerY[3] = bottomY - offset;
+        }
+
+        uint32_t corners[4];
+        for (int i = 0; i < 4; i++) {
+            const int e = (i < 2) ? top : bottom;
+            const int16_t sx = int16_t(std::clamp(cornerX[i], int32_t(INT16_MIN), int32_t(INT16_MAX)));
+            const int16_t sy = int16_t(std::clamp(cornerY[i], int32_t(INT16_MIN), int32_t(INT16_MAX)));
+            corners[i] = copyVertex(endIndices[e]);
+            drawData.modifyPosUints.emplace_back(corners[i] << 1);
+            drawData.modifyPosUints.emplace_back((uint32_t(uint16_t(sx)) << 16) | uint16_t(sy));
+            drawData.posScreen[corners[i]][0] = sx / 4.0f;
+            drawData.posScreen[corners[i]][1] = sy / 4.0f;
+        }
+
+        // Both triangles start at a corner of the first endpoint, which provides the flat shade color.
+        const int first = (top == 0) ? 0 : 2;
+        const uint32_t q0 = corners[first], q1 = corners[(first + 1) % 4], q2 = corners[(first + 2) % 4], q3 = corners[(first + 3) % 4];
+        if ((geometryMode & shadingSmoothMask) == 0) {
+            for (int i = 0; i < 3; i++) {
+                drawData.normColBytes[q0 * 4 + i] = drawData.normColBytes[colorIndex * 4 + i];
+            }
+
+            drawData.fogIndices[q0] = drawData.fogIndices[colorIndex];
+            drawData.lightIndices[q0] = drawData.lightIndices[colorIndex];
+            drawData.lightCounts[q0] = drawData.lightCounts[colorIndex];
+        }
+
+        const uint32_t cullFlags = geometryMode & cullBothMask;
+        if (cullFlags != 0) {
+            geometryMode &= ~cullBothMask;
+            state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+        }
+
+        drawIndexedTri(q0, q1, q2, true);
+        drawIndexedTri(q0, q2, q3, true);
+
+        if (cullFlags != 0) {
+            geometryMode |= cullFlags;
+            state->updateDrawStatusAttribute(DrawAttribute::GeometryMode);
+        }
+    }
+
